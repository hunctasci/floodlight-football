{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floodlight-football",
  "compatibility_date": "2026-09-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "none",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      },
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "floodlight-football",
      "database_id": "05263c02-53d3-4c6d-b5fe-ca69b6149fb0",
      "migrations_dir": "migrations"
    }
  ],
  "exports": {
    "RoomDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Matchmaker": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "routes": [
    {
      "pattern": "hncleague.com",
      "custom_domain": true
    },
    {
      "pattern": "www.hncleague.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
