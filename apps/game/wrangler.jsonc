{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floodlight-football",
  "compatibility_date": "2026-09-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDurableObject" }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "floodlight-football",
      "database_id": "local-city-league",
      "migrations_dir": "migrations"
    }
  ],
  "exports": {
    "RoomDurableObject": { "type": "durable-object", "storage": "sqlite" }
  }
}
