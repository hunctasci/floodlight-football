# Copy to .env and adjust. Never commit real secrets (.env is git-ignored).
PORT=8080
# Unset = ephemeral in-memory store (dev/tests). Set for self-host/prod:
# REDIS_URL=redis://redis:6379
ROOM_TTL_SEC=7200
RATE_CREATE_PER_MIN=5
RATE_JOIN_PER_MIN=20
RATE_SIGNAL_PER_MIN=240
RATE_LEAGUE_PER_MIN=10
MAX_PAYLOAD_BYTES=65536
LOG_LEVEL=info
# CORS origin for /api + /healthz. "*" is fine for local dev; in production
# set this to your game origin (e.g. https://football.example.com).
CLIENT_ORIGIN=*
# Persistent league store. Unset = memory leagues (vanish on restart).
# Compose: DATABASE_URL=postgres://retro:${POSTGRES_PASSWORD}@postgres:5432/retro
# DATABASE_URL=postgres://retro:change-me-in-production@postgres:5432/retro
# Production: generate a strong password and export POSTGRES_PASSWORD in your
# shell or secret manager — never leave the change-me default in prod.
# POSTGRES_PASSWORD=change-me-in-production
