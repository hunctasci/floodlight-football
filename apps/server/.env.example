# Copy to .env and adjust. Never commit real secrets.
PORT=8080
# Unset = ephemeral in-memory store (dev/tests). Set for production:
# REDIS_URL=redis://redis:6379
ROOM_TTL_SEC=7200
RATE_CREATE_PER_MIN=5
RATE_JOIN_PER_MIN=20
RATE_SIGNAL_PER_MIN=240
RATE_LEAGUE_PER_MIN=10
MAX_PAYLOAD_BYTES=65536
LOG_LEVEL=info
CLIENT_ORIGIN=*
# F4b: DATABASE_URL=postgres://retro:change-me-in-production@postgres:5432/retro
