{
  "name": "floodlight-football-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:game": "npm run dev --workspace=floodlight-football",
    "dev:server": "npm run dev --workspace=@floodlight/server",
    "cf:types": "npm run cf:types --workspace=floodlight-football",
    "cf:check": "npm run cf:check --workspace=floodlight-football",
    "test:e2e": "npm run test:e2e --workspace=floodlight-football",
    "social:frame": "tsx packages/social-video/scripts/render-frame.ts",
    "social:frames": "tsx packages/social-video/scripts/render-frames.ts",
    "social:render": "tsx packages/social-video/scripts/render-video.ts",
    "social:trailer-board": "tsx packages/social-video/scripts/render-trailer-storyboard.ts",
    "social:validate": "npm run validate --workspace=@floodlight/social-video",
    "reels:studio": "npm run studio --workspace=@floodlight/reels",
    "reels:render": "tsx packages/reels/scripts/render.ts",
    "reels:still": "tsx packages/reels/scripts/still.ts",
    "reels:validate": "npm run validate --workspace=@floodlight/reels",
    "reels:test": "npm run test --workspace=@floodlight/reels",
    "reels:asset:import": "npm run asset:import --workspace=@floodlight/reels",
    "deploy": "npm run deploy --workspace=floodlight-football"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  }
}
